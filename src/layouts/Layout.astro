---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arzium — Software a medida desde Salta",
  description = "Arzium es un estudio de desarrollo de software: sistemas a medida, landing pages y capacitaciones. Salta, Argentina.",
} = Astro.props;

/* Vista previa al compartir el link (WhatsApp, LinkedIn, X…). Imagen 1200×630 en public/og.png. */
const share = {
  title: "Arzium",
  description: "Software a medida: sistemas, landing pages y capacitaciones.",
  image: new URL("/og.png", Astro.site).href,
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arzium" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={share.image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de Arzium: software a medida" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={share.title} />
    <meta name="twitter:description" content={share.description} />
    <meta name="twitter:image" content={share.image} />
    <meta name="theme-color" content="#f2f1ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a
      href="#trabajos"
      class="fixed -left-[9999px] top-2 z-[100] rounded-lg bg-ink px-3.5 py-2.5 text-white focus:left-2"
    >Saltar al contenido</a>
    <slot />
    <script>
      import "../scripts/cal";

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
