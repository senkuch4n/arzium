---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { projects } from "../data/site";

const count = String(projects.length).padStart(2, "0");
---

<section id="trabajos" class="px-[var(--gutter)] pt-[clamp(80px,12vw,180px)]" aria-labelledby="work-title">
  <SectionHead id="work-title" title="Trabajos" sup="’26">
    <span class="font-mono text-sm">( {count} )</span>
  </SectionHead>

  <ul class="grid gap-x-[var(--gutter)] gap-y-16 lg:grid-cols-2">
    {
      projects.map((p) => (
        <li class="reveal">
          <a href={p.url} target="_blank" rel="noopener" class="group block">
            <div class="aspect-[16/10] overflow-hidden rounded-md bg-line">
              {p.image ? (
                <Image
                  src={p.image.src}
                  alt={p.image.alt}
                  widths={[720, 1080, 1440]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  class="size-full scale-[1.02] object-cover object-top transition-transform duration-1000 ease-out-expo group-hover:scale-[1.07]"
                />
              ) : (
                <div
                  class="grid size-full place-items-center bg-[#0f1720] bg-[radial-gradient(circle_at_30%_20%,rgba(75,5,248,.5),transparent_55%),radial-gradient(circle_at_80%_90%,rgba(0,200,255,.25),transparent_50%)] transition-[filter] duration-500 group-hover:brightness-110 group-hover:saturate-150"
                  aria-hidden="true"
                >
                  <span class="text-center text-[clamp(40px,6vw,96px)] leading-[.9] font-black tracking-[-0.05em] text-white uppercase">
                    {p.cover?.title}
                    <small class="mt-3.5 block font-mono text-[13px] font-normal tracking-[.04em] opacity-70">{p.cover?.subtitle}</small>
                  </span>
                </div>
              )}
            </div>

            <div class="mt-4 grid grid-cols-[auto_1fr_auto] items-center gap-x-3.5 sm:grid-cols-[auto_1fr_auto_auto_auto]">
              <span class:list={["grid size-9 place-items-center rounded-lg text-[13px] font-extrabold", p.icon.className]} aria-hidden="true">
                {p.icon.text}
              </span>
              <h3 class="text-[22px] font-semibold tracking-[-0.02em]">{p.name}</h3>
              <span class="col-start-2 row-start-2 font-medium text-muted sm:col-start-auto sm:row-start-auto">{p.category}</span>
              <span class="font-medium text-muted max-sm:hidden">{p.year}</span>
              <span
                class="col-start-3 row-start-1 grid size-9 place-items-center rounded-full border border-line transition duration-300 ease-out-expo group-hover:rotate-45 group-hover:border-violet group-hover:bg-violet group-hover:text-white sm:col-start-auto sm:row-start-auto"
                aria-hidden="true"
              >↗</span>
            </div>
            <p class="mt-2.5 font-mono text-[12.5px] tracking-[.03em] text-muted uppercase">{p.tags.join(" · ")}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
