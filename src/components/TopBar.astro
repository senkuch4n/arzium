---
import { calUrl } from "../data/site";

const items = [
  { title: "Salta, Argentina", sub: "Trabajando en todo el país", hide: "" },
  { title: "Construyendo", sub: "Numa & Factum", hide: "max-sm:hidden" },
  { title: "Agenda abierta", sub: "Nuevos proyectos · 2027", hide: "max-lg:hidden" },
];
---

<header
  class="relative z-10 grid grid-cols-[1fr_auto] items-center gap-[var(--gutter)] px-[var(--gutter)] pt-6 sm:grid-cols-[1fr_1fr_auto] lg:grid-cols-[1fr_1fr_1fr_auto]"
>
  {
    items.map((i) => (
      <div class:list={["flex flex-col leading-tight font-medium", i.hide]}>
        <strong class="font-medium">{i.title}</strong>
        <span class="text-muted">{i.sub}</span>
      </div>
    ))
  }
  <div class="flex items-center gap-2 sm:gap-3">
  <button
    type="button"
    data-theme-toggle
    aria-label="Cambiar entre modo claro y oscuro"
    class="group grid size-11 cursor-pointer place-items-center rounded-full border border-line transition-colors duration-300 hover:border-ink sm:size-[52px]"
  >
    <!-- Sol (visible en oscuro) / Luna (visible en claro) -->
    <svg class="size-5 transition-transform duration-500 ease-out-expo group-hover:rotate-45 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="hidden size-5 transition-transform duration-500 ease-out-expo group-hover:rotate-90 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  <a
    href={calUrl}
    data-cal-open
    class="inline-flex items-center gap-2 rounded-full bg-ink px-[18px] py-3 font-semibold text-bg hover:text-white transition duration-300 ease-out-expo hover:-translate-y-0.5 hover:bg-violet sm:px-[26px] sm:py-4"
  >
    Hablemos <span aria-hidden="true">→</span>
  </a>
  </div>
</header>
