---
import { getImage } from "astro:assets";
import icon from "../assets/arzium-icono-sin-fondo.png";

/* Ícono optimizado que usan las partículas como "molde" (solo se lee su forma). */
const mold = await getImage({ src: icon, width: 720, format: "png" });

/** Fragmentos del código que se "tipea": [clase de color, texto]. */
const code: [string, string][] = [
  ["text-muted", "// arzium.com.ar\n"],
  ["text-violet", "const "], ["", "proyecto = "], ["text-violet", "await "], ["", "arzium.construir({\n"],
  ["", "  tipo: "], ["text-ink font-medium", '"sistema a medida"'], ["", ",\n"],
  ["", "  foco: "], ["text-ink font-medium", '"tu negocio"'], ["", ",\n"],
  ["", "  entrega: "], ["text-ink font-medium", '"rápida y prolija"'], ["", ",\n"],
  ["", "});\n"],
  ["", "proyecto.lanzar(); "], ["text-muted", "// 🚀"],
];
---

<section
  class="relative -mt-16 grid min-h-svh grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto_auto] px-[var(--gutter)] pt-[84px] pb-7 sm:-mt-20 sm:pt-[90px]"
  aria-labelledby="hero-title"
>
  <div class="relative min-h-[300px]">
    <canvas data-particles data-src={mold.src} class="absolute inset-0 size-full touch-pan-y" aria-hidden="true"></canvas>

    <pre
      class="pointer-events-none absolute bottom-2 left-0 m-0 hidden font-mono text-[13px] leading-[1.7] whitespace-pre text-body lg:block"
      aria-hidden="true"><code data-typed data-code={JSON.stringify(code)}></code><span class="inline-block h-[1.1em] w-[.55em] animate-blink bg-violet align-[-0.2em]"></span></pre>

    <p class="pointer-events-none absolute right-0 bottom-2 font-mono text-xs tracking-[.08em] text-muted uppercase" aria-hidden="true">
      <span class="pointer-fine:hidden">Tocá el ícono</span><span class="hidden pointer-fine:inline">Pasá el cursor ↖</span>
    </p>
  </div>

  <h1 id="hero-title" class="mt-6 font-black">
    <span class="mb-3 flex justify-between text-xs font-semibold uppercase sm:mb-[.2em] sm:text-base">
      <span>Un estudio</span><span>de software</span><span class="max-sm:hidden">a medida</span>
    </span>
    <span
      class="flex flex-col text-[17vw] leading-[.86] tracking-[-0.045em] whitespace-nowrap uppercase sm:flex-row sm:items-baseline sm:justify-between sm:text-[clamp(56px,11.6vw,230px)] sm:leading-[.82]"
    >
      <span class="inline-block animate-rise">Código</span>
      <span class="inline-flex items-baseline gap-[.12em] max-sm:mt-[.04em] sm:contents">
        <em
          class="inline-block animate-rise font-serif text-[.92em] font-normal tracking-[-0.02em] text-violet normal-case [animation-delay:.1s] sm:text-[1.05em]"
        >que</em>
        <span class="inline-block animate-rise [animation-delay:.18s]">rinde</span>
      </span>
    </span>
  </h1>

  <div class="mt-9 flex justify-between pb-[76px] text-sm font-medium sm:text-base" aria-hidden="true">
    <span>↓ Deslizá para ver</span>
    <span>lo que construimos ↓</span>
  </div>
</section>

<script>
  import { mountParticles } from "../scripts/particles";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-particles]");
  if (canvas?.dataset.src) mountParticles(canvas, canvas.dataset.src);

  const el = document.querySelector<HTMLElement>("[data-typed]");
  if (el) {
    const parts = JSON.parse(el.dataset.code ?? "[]") as [string, string][];
    const total = parts.reduce((n, [, t]) => n + t.length, 0);

    const render = (count: number) => {
      el.replaceChildren();
      let left = count;
      for (const [cls, text] of parts) {
        if (left <= 0) break;
        const node = cls ? Object.assign(document.createElement("span"), { className: cls }) : null;
        const content = document.createTextNode(text.slice(0, left));
        el.append(node ? (node.append(content), node) : content);
        left -= text.length;
      }
    };

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) render(total);
    else {
      let i = 0;
      const tick = () => {
        render(++i);
        if (i < total) setTimeout(tick, 28 + Math.random() * 40);
      };
      setTimeout(tick, 1200);
    }
  }
</script>
