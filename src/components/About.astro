---
const text =
  "Somos Arzium, un equipo de desarrollo de Salta. Diseñamos y programamos sistemas que ordenan el trabajo de verdad, sitios que convierten visitas en clientes y capacitaciones para que tu equipo saque provecho de la tecnología. Sin humo: software claro, rápido y hecho para durar.";
const words = text.split(" ");
---

<section id="nosotros" class="grid gap-[var(--gutter)] px-[var(--gutter)] pt-[clamp(80px,12vw,180px)] lg:grid-cols-[1fr_3fr]">
  <h2 class="font-semibold tracking-wide text-muted uppercase">Nosotros</h2>
  <p data-words class="text-[clamp(26px,3.5vw,54px)] leading-[1.08] font-semibold tracking-[-0.03em]">
    {words.map((w) => <span class="transition-opacity duration-500 [.js_&]:opacity-15 [&.on]:opacity-100!">{w} </span>)}
  </p>
</section>

<script>
  const about = document.querySelector<HTMLElement>("[data-words]");
  if (about) {
    const words = [...about.children];
    const update = () => {
      const r = about.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35)));
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.classList.toggle("on", i < lit));
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) words.forEach((w) => w.classList.add("on"));
    else {
      addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
      update();
    }
  }
</script>
