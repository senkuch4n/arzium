---
import { calUrl, contact } from "../data/site";

const items = [
  { label: "Email", value: contact.email, href: `mailto:${contact.email}`, external: false },
  ...contact.phones.map((p) => ({ label: "WhatsApp", value: p.label, href: `https://wa.me/${p.wa}`, external: true })),
];
---

<section id="contacto" class="px-[var(--gutter)] pt-[clamp(80px,12vw,180px)] pb-10" aria-labelledby="contact-title">
  <p class="font-semibold tracking-wide text-muted uppercase">¿Tenés un proyecto?</p>
  <h2 id="contact-title" class="mt-[18px] mb-12 text-[clamp(64px,17vw,320px)] leading-[.8] font-black tracking-[-0.06em] uppercase">
    <a href={calUrl} data-cal-open class="group inline-flex items-start gap-[.05em] transition-colors duration-300 hover:text-violet">
      Hablemos<span class="text-[.35em] transition-transform duration-500 ease-out-expo group-hover:translate-x-[.1em] group-hover:-translate-y-[.1em]" aria-hidden="true">↗</span>
    </a>
  </h2>

  <div class="grid gap-y-10 border-t border-ink pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-x-[var(--gutter)]">
    <div>
      <h3 class="text-[clamp(26px,2.6vw,40px)] leading-[1.05] font-bold tracking-[-0.03em]">Agendá una llamada</h3>
      <p class="mt-3 max-w-[36ch] text-lg text-body">
        Elegí el día y el horario que te quede cómodo. Charlamos sobre tu proyecto y te contamos cómo lo encararíamos.
      </p>

      <p class="mt-10 font-semibold tracking-wide text-muted uppercase">¿Preferís escribirnos?</p>
      <ul class="mt-2">
        {
          items.map((i) => (
            <li>
              <a
                href={i.href}
                {...(i.external && { target: "_blank", rel: "noopener" })}
                class="block border-b border-line py-4 text-[clamp(18px,1.6vw,24px)] font-semibold tracking-[-0.02em] [overflow-wrap:anywhere] hover:text-violet"
              >
                <small class="mb-1 block text-sm font-medium tracking-normal text-muted">{i.label}</small>
                {i.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="min-h-[640px] overflow-hidden rounded-md border border-line bg-white">
      <div id="cal-inline" class="size-full min-h-[640px] overflow-auto">
        <noscript>
          <p class="p-6">Para ver la agenda activá JavaScript o entrá a <a class="text-violet underline" href={calUrl}>{calUrl}</a>.</p>
        </noscript>
      </div>
    </div>
  </div>
</section>
